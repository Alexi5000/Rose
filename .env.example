# Rose local environment template
# Copy to .env and fill in real values. Do not commit secrets.

# Required providers
GROQ_API_KEY=""
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# LLM provider routing
# Groq is the default low-latency provider. Set LLM_PROVIDER=openrouter to route
# primary text generation through OpenRouter, or keep Groq primary and configure
# OPENROUTER_API_KEY to enable OpenRouter fallback.
LLM_PROVIDER="groq"
LLM_FALLBACK_PROVIDER="openrouter"
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL_NAME="openai/gpt-oss-120b"
OPENROUTER_APP_NAME="Rose"

# Model configuration
TEXT_MODEL_NAME="openai/gpt-oss-120b"
SMALL_TEXT_MODEL_NAME="openai/gpt-oss-20b"
STT_PROVIDER="groq"
STT_MODEL_NAME="whisper-large-v3-turbo"
# Optional streaming STT provider. Requires installing the streaming-stt extra.
DEEPGRAM_API_KEY=""
DEEPGRAM_MODEL_NAME="nova-3"
DEEPGRAM_LANGUAGE="en-US"
DEEPGRAM_AUDIO_MIMETYPE="audio/webm"
DEEPGRAM_ENDPOINTING_MS="300"
DEEPGRAM_UTTERANCE_END_MS="1000"
# TTS_PROVIDER can be elevenlabs for server audio, or text_only/browser_speech
# for degraded local mode where the frontend uses browser speech synthesis.
TTS_PROVIDER="elevenlabs"
TTS_MODEL_NAME="eleven_turbo_v2_5"

# Server and browser access
HOST="0.0.0.0"
PORT="8000"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
ENABLE_API_DOCS="true"

# Memory and local data
EMBEDDING_PROVIDER="sentence_transformer"
MEMORY_PROVIDER="long_term"
MEMORY_TOP_K="5"
SHORT_TERM_MEMORY_DB_PATH="./data/memory.db"
BACKUP_DIR="./data/backups"

# Safety
SAFETY_PROVIDER="deterministic"

# Voice tuning
TTS_VOICE_STABILITY="0.50"
TTS_VOICE_SIMILARITY="0.75"
TTS_VOICE_STYLE="0.15"
TTS_VOICE_SPEED="0.92"
TTS_OUTPUT_FORMAT="mp3_44100_128"
TTS_USE_SPEAKER_BOOST="true"
TTS_LANGUAGE_CODE="en"

# Reliability and observability
ENVIRONMENT="development"
LOG_LEVEL="INFO"
LOG_FORMAT="console"
# Keep transcripts, memory text, and provider payload previews out of logs by default.
# Set true only for local debugging with consented/test data.
LOG_SENSITIVE_CONTENT="false"
RATE_LIMIT_ENABLED="true"
FEATURE_TTS_CACHE_ENABLED="true"
FEATURE_TIMING_METRICS_ENABLED="true"
SENTRY_DSN=""
